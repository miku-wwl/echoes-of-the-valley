MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1347827477}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 422784df8c1ca0e45b34c845d1151002, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Echoes.Runtime::Echoes.NpcInteractable
  prompt: Talk to Mira
  range: 3
  interactionPoint: {fileID: 0}
  dialogue: {fileID: 1852339975}
  objective: {fileID: 839095102}
  speaker: Mira
  introLines:
  - Oh! A visitor... and just in time, too.
  - This valley used to hum with life. Then the old spring cracked, and the song
    went out of everything.
  - Would you visit the ruined spring beside the pond? See what is left of it, then
    come back to the Heart of the Valley.
  springHintLines:
  - The spring is past the pond, west of the old plaza. Take your time - the valley
    isn't going anywhere.
  heartHintLines:
  - You have seen the spring? Then go back to the Heart, the ring of old stones in
    the middle of the valley. I think it will answer you.
  completedLines:
  - Listen... can you hear it? The valley is stirring again.
  - There is so much more to mend. Come and find me once you are ready.
