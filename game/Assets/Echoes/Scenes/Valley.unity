--- !u!114 &646583816
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 646583814}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b17c5e4475ea7774184bdfcebe21a8e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Echoes.Runtime::Echoes.HeartInteractable
  prompt: Touch the Heart Stone
  range: 4.5
  interactionPoint: {fileID: 0}
  dialogue: {fileID: 1852339975}
  objective: {fileID: 839095102}
  speaker: The Heart of the Valley
  tooEarlyLines:
  - 'The Heart of the Valley: a ring of broken pillars around a dull, dormant crystal.
    It feels like it is listening, but it is not ready yet.'
  - Perhaps someone in the cottage knows its story.
  touchLines:
  - You rest a hand on the old stone. For a moment, everything holds its breath...
  - Then the crystal wakes. A soft note rings out across the valley, and warm light
    spreads over the hills.
  afterLines:
  - The crystal glows softly. The valley's restoration will continue in Phase 2.
